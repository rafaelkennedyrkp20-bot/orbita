# ─────────────────────────────────────────────────────────
# AgentePessoal — Variáveis de ambiente (ficam só neste PC)
# As chaves também podem ser preenchidas pela interface: ⚙ Configurações → Chaves de API
# ─────────────────────────────────────────────────────────

# ─── Chaves de API (preencha só as que for usar) ─────────
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=

# ─── Modelo local padrão (Ollama) ───────────────────────
# LLM_MODEL=qwen3:14b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ─── REA (engenharia reversa) ───────────────────────────
# Para decompilar binários nativos, instale o Ghidra 12.1.x e aponte a pasta:
# GHIDRA_INSTALL_DIR=C:\ghidra_12.1

# ─── Logs: DEBUG | INFO | WARNING | ERROR ────────────────
# LOG_LEVEL=INFO
